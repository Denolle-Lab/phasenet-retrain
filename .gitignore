# label audit (41B, scripts/audit_source_labels.py): summary.csv, provenance.json,
# report.md, review_sheet.csv and the C5 pair list are committed; rows.parquet is not
!data/label_audit/
data/label_audit/**/rows.parquet
# 41B benchmark label audit: the per-trace flag table is regenerated by scripts/audit_benchmark_labels.py
docs/audit_2026-09-16_benchmark_labels/per_trace_flags.parquet

# source census (2026-09-11, #39A): the census CSVs are committed, the cached
# raw bulletin responses under data/census/raw/ are not
!data/census/
!data/census/*.csv
data/census/raw/

# 35A/36B scoring and association outputs (data/evaluation/scores, annotations,
# events, access.jsonl) are regenerated by scripts/heldout_testset_score.py and
# docs/event_baselines_2026-09-17/run_event_baselines.py; only the summary CSVs
# under docs/ are committed (data/* above already covers them; stated for clarity)
data/evaluation/
data/evaluation/events/

# noise pools (42A): the pool manifest and its provenance are committed, the
# waveforms (.npz per station-day) and the raw FDSN cache are not
!data/noise_pools/
!data/noise_pools/*/
!data/noise_pools/*/manifest.parquet
!data/noise_pools/*/manifest.json
data/noise_pools/raw/
data/noise_pools/*/windows/

